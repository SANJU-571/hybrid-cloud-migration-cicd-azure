#cloud-config
# Fraud-detection microservice (private app tier - no public IP)
write_files:
  - path: /opt/fraud/app.py
    content: |
      import json, random, socket, datetime
      from http.server import BaseHTTPRequestHandler, HTTPServer

      class Handler(BaseHTTPRequestHandler):
          def do_GET(self):
              body = {
                  "service": "fraud-detection",
                  "host": socket.gethostname(),
                  "tier": "private app subnet",
                  "risk_score": round(random.random(), 3),
                  "checked_at": datetime.datetime.utcnow().isoformat() + "Z",
              }
              data = json.dumps(body).encode()
              self.send_response(200)
              self.send_header("Content-Type", "application/json")
              self.send_header("Content-Length", str(len(data)))
              self.end_headers()
              self.wfile.write(data)

          def log_message(self, *args):
              pass

      HTTPServer(("0.0.0.0", 8080), Handler).serve_forever()

  - path: /etc/systemd/system/fraud-detection.service
    content: |
      [Unit]
      Description=N-Financial Bank fraud-detection API
      After=network-online.target
      [Service]
      ExecStart=/usr/bin/python3 /opt/fraud/app.py
      Restart=always
      DynamicUser=yes
      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl daemon-reload
  - systemctl enable --now fraud-detection.service
